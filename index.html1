<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pyroom: Python editor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@500;700&display=swap">
<style>
:root{--bg:#000;--panel:#0b0b0b;--line:#222;--ink:#f2f2f2;--dim:#8a8a8a;--acc:#3d6bff;--err:#ff6b6b;--ok:#5ee08a;
--mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;--ui:Inter,system-ui,sans-serif}
html[data-theme="light"]{--bg:#fff;--panel:#f6f6f6;--line:#dcdcdc;--ink:#0a0a0a;--dim:#6b6b6b;--acc:#1f49e0;--err:#c62828;--ok:#16803c}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--ui);display:flex;flex-direction:column;height:100dvh;
padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
header{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--line)}
h1{font-size:15px;margin:0;flex:1;letter-spacing:.2px}
#status{font:12px var(--mono);color:var(--dim)}
button{font:600 13px var(--ui);border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:8px 14px;border-radius:8px;cursor:pointer}
button:focus-visible,textarea:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
#run{background:var(--acc);border-color:var(--acc);color:#fff}
#run:disabled{opacity:.5;cursor:wait}
main{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr}
section{display:flex;flex-direction:column;min-height:0;min-width:0}
#edpane{border-right:1px solid var(--line)}
.label{font:600 12px var(--ui);color:var(--dim);padding:6px 12px;border-bottom:1px solid var(--line);background:var(--panel);display:flex;justify-content:space-between}
.ed{flex:1;display:flex;min-height:0}
#gut{font:14px/1.6 var(--mono);color:var(--dim);text-align:right;padding:12px 8px;overflow:hidden;user-select:none;border-right:1px solid var(--line);background:var(--panel);white-space:pre}
textarea{font:14px/1.6 var(--mono);background:var(--bg);color:var(--ink);border:0;resize:none;padding:12px;tab-size:4;white-space:pre;overflow:auto}
#code{flex:1;min-width:0}
#stdin{height:84px;border-top:1px solid var(--line);white-space:pre-wrap}
#out{flex:1;margin:0;padding:12px;font:14px/1.6 var(--mono);white-space:pre-wrap;word-break:break-word;overflow:auto}
.e{color:var(--err)}.m{color:var(--dim)}
@media (max-width:800px){
 main{grid-template-columns:1fr;grid-template-rows:1fr 1.2fr}
 #outpane{order:-1;border-bottom:1px solid var(--line)}
 #edpane{border-right:0}
 #stdin{height:56px}
}
</style>
</head>
<body>
<header>
 <h1>Pyroom</h1>
 <span id="status">Loading Python…</span>
 <button id="theme" aria-label="Switch theme">Light</button>
 <button id="run" disabled>Run</button>
</header>
<main>
 <section id="edpane">
  <div class="label"><span>main.py</span><span>Ctrl+Enter to run</span></div>
  <div class="ed"><div id="gut">1</div><textarea id="code" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea></div>
  <div class="label"><span>Input (one line per input() call)</span></div>
  <textarea id="stdin" spellcheck="false" placeholder="Type input here"></textarea>
 </section>
 <section id="outpane">
  <div class="label"><span>Output</span><span id="clear" role="button" tabindex="0" style="cursor:pointer">Clear</span></div>
  <pre id="out"></pre>
 </section>
</main>
<script src="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js"></script>
<script>
const $=id=>document.getElementById(id);
const code=$("code"),gut=$("gut"),out=$("out"),run=$("run"),status=$("status");
const SAMPLE=`import re

name = input("Name: ")
text = input("Text: ")
words = re.findall(r"\\w+", text)
print(f"Hi {name}, you typed {len(words)} words.")
`;
let py=null;

/* theme */
function setTheme(t){document.documentElement.dataset.theme=t;$("theme").textContent=t==="dark"?"Light":"Dark";try{localStorage.setItem("theme",t)}catch(e){}}
let saved=null;try{saved=localStorage.getItem("theme")}catch(e){}
setTheme(saved||(matchMedia("(prefers-color-scheme: light)").matches?"light":"dark"));
$("theme").onclick=()=>setTheme(document.documentElement.dataset.theme==="dark"?"light":"dark");

/* editor */
try{code.value=localStorage.getItem("code")||SAMPLE}catch(e){code.value=SAMPLE}
function lines(){const n=code.value.split("\n").length;gut.textContent=Array.from({length:n},(_,i)=>i+1).join("\n");gut.scrollTop=code.scrollTop}
code.addEventListener("input",()=>{lines();try{localStorage.setItem("code",code.value)}catch(e){}});
code.addEventListener("scroll",()=>gut.scrollTop=code.scrollTop);
code.addEventListener("keydown",e=>{
 if(e.key==="Tab"){e.preventDefault();const s=code.selectionStart;code.setRangeText("    ",s,code.selectionEnd,"end");code.dispatchEvent(new Event("input"))}
 if(e.key==="Enter"&&(e.ctrlKey||e.metaKey)){e.preventDefault();go()}
 if(e.key==="Enter"&&!e.ctrlKey&&!e.metaKey){ /* keep indentation */
  const s=code.selectionStart,before=code.value.slice(0,s),ln=before.slice(before.lastIndexOf("\n")+1);
  let ind=ln.match(/^\s*/)[0];if(/:\s*$/.test(ln))ind+="    ";
  e.preventDefault();code.setRangeText("\n"+ind,s,code.selectionEnd,"end");code.dispatchEvent(new Event("input"));
 }
});
lines();

/* output */
function put(txt,cls){const s=document.createElement("span");if(cls)s.className=cls;s.textContent=txt;out.appendChild(s);out.scrollTop=out.scrollHeight}
$("clear").onclick=()=>out.textContent="";

/* python */
async function init(){
 try{
  py=await loadPyodide();
  py.setStdout({batched:s=>put(s+"\n")});
  py.setStderr({batched:s=>put(s+"\n","e")});
  status.textContent="Python ready";run.disabled=false;
 }catch(err){status.textContent="Failed to load";put("Could not load Python. Check your internet connection and reload.\n","e")}
}
async function go(){
 if(!py||run.disabled)return;
 run.disabled=true;status.textContent="Running…";out.textContent="";
 const inp=$("stdin").value.split("\n");let i=0;
 py.setStdin({stdin:()=>i<inp.length?inp[i++]:undefined});
 try{
  await py.loadPackagesFromImports(code.value);
  await py.runPythonAsync(code.value);
  put("\n[finished]","m");
 }catch(err){
  put(String(err.message||err).trim()+"\n","e");
 }
 status.textContent="Python ready";run.disabled=false;
}
run.onclick=go;
init();
</script>
</body>
</html>
